{
  "name": "dsh-llm-key-pool",
  "description": "Loopback model-API proxy that schedules requests across several API keys within per-key rate limits, for DeepSeek Harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.6-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.11-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.7-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
